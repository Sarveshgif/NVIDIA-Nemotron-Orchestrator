# Copy to .env.investigation in the repository root; never commit actual keys.
# Existing .env values are reused and take precedence.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Optional; leave blank to use the configured model's default reasoning effort.
NVIDIA_REASONING_EFFORT=
# Completion budget includes reasoning tokens. Increase only if the chosen model supports it.
NVIDIA_MAX_TOKENS=2048
# Transient network/429/5xx retries, still within the total investigation budget.
NVIDIA_MAX_ATTEMPTS=3
NVIDIA_READ_TIMEOUT_SECONDS=60
# Maximum simultaneous NVIDIA requests per backend process; queueing uses the run budget.
NVIDIA_MAX_CONCURRENCY=2
# Counts retries too; shared per backend process, not across other clients/servers.
NVIDIA_REQUESTS_PER_MINUTE=40
NVIDIA_CIRCUIT_FAILURE_THRESHOLD=3
NVIDIA_CIRCUIT_COOLDOWN_SECONDS=20
# Retrieve the three required sources before the first model request.
INVESTIGATION_PREFETCH_EVIDENCE=true
# Malformed responses / rejected hypotheses may receive this many correction attempts.
# Attempts still consume the existing six-round, eight-tool and 180-second budgets.
INVESTIGATION_MAX_CORRECTIONS=2
INVESTIGATION_PORT=8788
INVESTIGATION_THRESHOLD=0.80
INVESTIGATION_SPATIAL_EVIDENCE=true
SENTINEL_MAX_SCENES=20
SENTINEL_BUDGET_SECONDS=90
# Server/CLI default: binary predictions whenever RF exists; evidence verdict is separate.
# evidence_only restores strict abstention. No combined probability is fabricated.
INVESTIGATION_PREDICTION_MODE=always_predict
RF_BUNDLE=rf_silage_grain_models/rf_nl_console.joblib
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Direct public URLs are preferred; no Google/Brave search is used by default.
PUBLIC_SEARCH_ENABLED=false
PUBLIC_REPORT_SOURCES=investigation/public_report_sources.json
# Aggregate acreage only; these sources are excluded from field investigations.
NASS_API_KEY=
# Alternative to a NASS key: official Quick Stats CSV downloaded by the user.
AGRICULTURAL_CSV=
# Optional registry of manually verified public actual-harvest records; never evaluation labels.
VERIFIED_HARVEST_RECORDS=
# Low-score branch only in always_predict mode; no extra high-score requests.
INVESTIGATION_HISTORICAL_WEATHER=true
# Requires configured NASS_API_KEY; missing data stays explicit and does not block prediction.
INVESTIGATION_NASS_CONTEXT=true
DAYMET_BASELINE_START=1981
DAYMET_BASELINE_END=2010
WEATHER_RAIN_3DAY_MM=10
WEATHER_DROUGHT_PERCENTILE=20
