{
  "name": "harvest-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/to-artifact.mjs",
    "preview": "vite preview",
    "agent:server": ".venv-investigation/bin/python -m investigation.server",
    "agent:run": ".venv-investigation/bin/python -m investigation run",
    "agent:test": ".venv-investigation/bin/python -m unittest discover -s tests/investigation -v",
    "agent:models": ".venv-investigation/bin/python -m investigation inspect-models"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
